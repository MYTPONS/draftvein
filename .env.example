# OpenAI-compatible model endpoint
NOVEL_FORGE_PROVIDER=openai
NOVEL_FORGE_BASE_URL=https://api.openai.com/v1
NOVEL_FORGE_API_KEY=replace-me
NOVEL_FORGE_MODEL=gpt-4o-mini

# Optional
# NOVEL_FORGE_BASE_URLS=https://endpoint-a.example/v1,https://endpoint-b.example/v1
# NOVEL_FORGE_MODELS=model-a,model-b
# NOVEL_FORGE_HOME=~/.novel-forge
# NOVEL_FORGE_PORT=4260

# Writer assistant login is obtained through the in-app QR flow.
# Never commit token/cookie values.
NOVEL_FORGE_ZUOJIA_TOKEN=
NOVEL_FORGE_ZUOJIA_COOKIE=
