# OpenAI-compatible model endpoint
DRAFTVEIN_PROVIDER=openai
DRAFTVEIN_BASE_URL=https://api.openai.com/v1
DRAFTVEIN_API_KEY=replace-me
DRAFTVEIN_MODEL=gpt-4o-mini

# Optional
# DRAFTVEIN_BASE_URLS=https://endpoint-a.example/v1,https://endpoint-b.example/v1
# DRAFTVEIN_MODELS=model-a,model-b
# DRAFTVEIN_HOME=~/.draftvein
# DRAFTVEIN_PORT=4260

# Writer assistant login is obtained through the in-app QR flow.
# Never commit token/cookie values.
DRAFTVEIN_ZUOJIA_TOKEN=
DRAFTVEIN_ZUOJIA_COOKIE=
